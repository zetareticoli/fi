{
  "name": "fi",
  "version": "1.0.0",
  "description": "Francesco Improta personal website and blog",
  "main": "gulpfile.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "style-dictionary build",
    "tw:build": "tailwindcss -i css/tw.css -o css/tw-compiled.css",
    "tw:watch": "tailwindcss -i css/tw.css -o css/tw-compiled.css --watch",
    "dev": "concurrently --kill-others-on-fail -n TW,JEKYLL -c cyan,yellow \"npm run tw:watch\" \"bundle exec jekyll serve --livereload\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zetareticoli/fi.git"
  },
  "author": "Francesco Improta",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zetareticoli/fi/issues"
  },
  "homepage": "https://github.com/zetareticoli/fi#readme",
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "gulp": "^5.0.0",
    "gulp-imagemin": "^7.1.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "concurrently": "^10.0.3",
    "style-dictionary": "^3.1.1"
  }
}
