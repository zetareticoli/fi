---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.url }}/experience/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ site.url }}/writing/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ site.url }}/about/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ site.url }}/projects/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>{{ site.url }}/workshop/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>{{ site.url }}/subscribe/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>0.4</priority>
  </url>

{% for work in site.work %}
  {% if work.url != '/experience/' %}
  <url>
    <loc>{{ site.url }}{{ work.url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>0.8</priority>
  </url>
  {% endif %}
{% endfor %}

{% for workshop in site.workshops %}
  {% unless workshop.url contains 'confirm' or workshop.url contains 'success' %}
  <url>
    <loc>{{ site.url }}{{ workshop.url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>0.6</priority>
  </url>
  {% endunless %}
{% endfor %}

{% for post in site.posts %}
  {% unless post.sitemap == false or post.published == false %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    <priority>{% if post.sitemap.priority %}{{ post.sitemap.priority }}{% else %}0.7{% endif %}</priority>
  </url>
  {% endunless %}
{% endfor %}

</urlset>
